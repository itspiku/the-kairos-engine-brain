# Environment Variables for The Kairos Engine
# Copy this to .env and fill in your values
# DO NOT commit .env to version control

# ── LLM Model Configuration ──────────────────────────────────────────────────
# Override the default Hugging Face repo/filename for the Gemma 4 GGUF model
KAIROS_MODEL_REPO=unsloth/gemma-4-E2B-it-GGUF
KAIROS_MODEL_FILENAME=gemma-4-E2B-it-Q4_K_M.gguf

# Override the model directory path (default: ./models)
KAIROS_MODEL_DIR=./models

# ── GPU Settings ──────────────────────────────────────────────────────────────
# Number of GPU layers to offload (-1 = all layers if GPU available, 0 = CPU only)
KAIROS_GPU_LAYERS=-1

# Context window size (tokens). Larger = more memory. Default: 4096
KAIROS_N_CTX=4096

# Number of parallel batch threads
KAIROS_N_BATCH=256

# CPU threads for inference (0 = auto-detect)
KAIROS_N_THREADS=8

# ── Risk Model ────────────────────────────────────────────────────────────────
# Path to the XGBoost crash predictor .json file
KAIROS_RISK_MODEL_PATH=kairos_crash_predictor.json

# Risk thresholds (probabilities 0-1)
KAIROS_CRITICAL_RISK_THRESHOLD=0.70
KAIROS_HIGH_RISK_THRESHOLD=0.40

# ── SLA Configuration ─────────────────────────────────────────────────────────
# Maximum acceptable decision latency in seconds
KAIROS_SLA_SEC=2.0

# ── Logging ───────────────────────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KAIROS_LOG_LEVEL=INFO

# Directory for log files (created automatically)
KAIROS_LOG_DIR=./logs

# ── External APIs ─────────────────────────────────────────────────────────────
# Open-Meteo does not require an API key (free tier)
# Open-Elevation does not require an API key (free tier)
# Add any premium API keys here if switching providers:
# OPENWEATHER_API_KEY=your_key_here
# MAPBOX_API_KEY=your_key_here

# ── Mission Defaults ──────────────────────────────────────────────────────────
# Default origin [lat,lon] — Pokhara Airfield
KAIROS_DEFAULT_ORIGIN_LAT=28.2096
KAIROS_DEFAULT_ORIGIN_LON=83.9856

# Default destination [lat,lon] — Muktinath Medical Clinic
KAIROS_DEFAULT_DEST_LAT=28.8167
KAIROS_DEFAULT_DEST_LON=83.8667

# ── Hugging Face (for model download) ────────────────────────────────────────
# Only needed if downloading private/gated models
# HF_TOKEN=your_huggingface_token_here
